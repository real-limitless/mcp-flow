{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/real-limitless/mcp-flow/catalog/schema.json",
  "title": "McpGalleryEntry",
  "description": "Normalized MCP gallery entry. schemaVersion 1.2.0 — packages/headers + enrichment; inactive when source repo 404",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "description", "transport", "provenance"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Stable allowlist id — official registry server.name"
    },
    "title": { "type": "string" },
    "description": {
      "type": "string",
      "description": "Full registry description of what the server does"
    },
    "summary": {
      "type": "string",
      "description": "Short blurb for indexes (≤160 chars typical)"
    },
    "offersHint": {
      "type": "string",
      "description": "Human-readable capability hint from registry metadata"
    },
    "version": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["active", "deprecated", "deleted", "inactive", "unknown"]
    },
    "transport": {
      "type": "string",
      "enum": ["streamable-http", "sse", "stdio", "unknown"]
    },
    "endpointUrl": { "type": "string" },
    "remotes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "url"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["streamable-http", "sse", "unknown"]
          },
          "url": { "type": "string" },
          "headers": {
            "type": "array",
            "items": { "$ref": "#/$defs/headerDoc" }
          }
        }
      }
    },
    "install": { "$ref": "#/$defs/package" },
    "packages": {
      "type": "array",
      "description": "All registry packages (npm/pypi/oci/…)",
      "items": { "$ref": "#/$defs/package" }
    },
    "environmentVariables": {
      "type": "array",
      "description": "Aggregated package env var docs (names only)",
      "items": { "$ref": "#/$defs/secretField" }
    },
    "flags": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["remote", "stdio", "incomplete", "repo-offline"]
      },
      "uniqueItems": true
    },
    "homepage": { "type": "string" },
    "sourceUrl": { "type": "string" },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": { "type": "string" },
        "source": { "type": "string" },
        "id": { "type": "string" },
        "subfolder": { "type": "string" }
      }
    },
    "categories": {
      "type": "array",
      "items": { "type": "string" }
    },
    "updatedAt": { "type": "string" },
    "publishedAt": { "type": "string" },
    "provenance": {
      "type": "string",
      "enum": ["official-registry", "manual"]
    },
    "requiresHeaders": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Header names marked required by registry"
    },
    "headerDocs": {
      "type": "array",
      "items": { "$ref": "#/$defs/headerDoc" }
    },
    "readme": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source"],
      "properties": {
        "source": {
          "type": "string",
          "enum": ["github", "gitlab", "url", "none"]
        },
        "url": { "type": "string" },
        "markdown": { "type": "string" },
        "fetchedAt": { "type": "string" },
        "truncated": { "type": "boolean" },
        "error": { "type": "string" }
      }
    },
    "sourceRepo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "description": "Live GitHub/GitLab existence check; not_found → inactive",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["ok", "not_found", "unreachable", "skipped", "unsupported"]
        },
        "url": { "type": "string" },
        "checkedAt": { "type": "string" },
        "httpStatus": { "type": "number" },
        "error": { "type": "string" },
        "host": {
          "type": "string",
          "enum": ["github", "gitlab"]
        }
      }
    },
    "toolsPreview": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "toolsPreviewAt": { "type": "string" },
    "toolsPreviewError": { "type": "string" },
    "toolsPreviewStatus": {
      "type": "string",
      "enum": ["ok", "auth_required", "unreachable", "unsupported", "skipped"]
    },
    "enrichment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "normalizedAt": { "type": "string" },
        "readmeAt": { "type": "string" },
        "toolsAt": { "type": "string" },
        "sourceRepoAt": { "type": "string" },
        "complete": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "secretField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "secret": { "type": "boolean" },
        "required": { "type": "boolean" },
        "default": { "type": "string" }
      }
    },
    "headerDoc": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "secret": { "type": "boolean" },
        "required": { "type": "boolean" },
        "default": { "type": "string" },
        "valueTemplate": {
          "type": "string",
          "description": "e.g. Bearer {api_key} — never a resolved credential"
        },
        "variables": {
          "type": "array",
          "items": { "$ref": "#/$defs/secretField" }
        }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["npm", "pypi", "oci", "binary", "unknown"]
        },
        "package": { "type": "string" },
        "version": { "type": "string" },
        "transport": {
          "type": "string",
          "enum": ["streamable-http", "sse", "stdio", "unknown"]
        },
        "command": {
          "type": "array",
          "items": { "type": "string" }
        },
        "environmentVariables": {
          "type": "array",
          "items": { "$ref": "#/$defs/secretField" }
        }
      }
    }
  }
}
