{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/real-limitless/mcp-flow/catalog/schema.json",
  "title": "McpGalleryEntry",
  "description": "Normalized MCP gallery entry. schemaVersion 1.1.0 — adds readme + toolsPreview enrichment",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "description", "transport", "provenance"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Stable allowlist id — official registry server.name"
    },
    "title": { "type": "string" },
    "description": {
      "type": "string",
      "description": "Full registry description of what the server does"
    },
    "summary": {
      "type": "string",
      "description": "Short blurb for indexes (≤160 chars typical)"
    },
    "offersHint": {
      "type": "string",
      "description": "Human-readable capability hint from registry metadata"
    },
    "version": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["active", "deprecated", "deleted", "unknown"]
    },
    "transport": {
      "type": "string",
      "enum": ["streamable-http", "sse", "stdio", "unknown"]
    },
    "endpointUrl": { "type": "string" },
    "remotes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "url"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["streamable-http", "sse", "unknown"]
          },
          "url": { "type": "string" }
        }
      }
    },
    "install": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["npm", "pypi", "oci", "binary", "unknown"]
        },
        "package": { "type": "string" },
        "command": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "flags": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["remote", "stdio", "incomplete"]
      },
      "uniqueItems": true
    },
    "homepage": { "type": "string" },
    "sourceUrl": { "type": "string" },
    "categories": {
      "type": "array",
      "items": { "type": "string" }
    },
    "updatedAt": { "type": "string" },
    "provenance": {
      "type": "string",
      "enum": ["official-registry", "manual"]
    },
    "requiresHeaders": {
      "type": "array",
      "items": { "type": "string" }
    },
    "headerDocs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" },
          "required": { "type": "boolean" }
        }
      }
    },
    "readme": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source"],
      "properties": {
        "source": {
          "type": "string",
          "enum": ["github", "gitlab", "url", "none"]
        },
        "url": { "type": "string" },
        "markdown": { "type": "string" },
        "fetchedAt": { "type": "string" },
        "truncated": { "type": "boolean" },
        "error": { "type": "string" }
      }
    },
    "toolsPreview": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "toolsPreviewAt": { "type": "string" },
    "toolsPreviewError": { "type": "string" },
    "toolsPreviewStatus": {
      "type": "string",
      "enum": ["ok", "auth_required", "unreachable", "unsupported", "skipped"]
    },
    "enrichment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "normalizedAt": { "type": "string" },
        "readmeAt": { "type": "string" },
        "toolsAt": { "type": "string" },
        "complete": { "type": "boolean" }
      }
    }
  }
}
