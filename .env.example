# Required: 32-byte key as base64 (or 64 hex chars). Generate:
#   openssl rand -base64 32
MCP_FLOW_MASTER_KEY=

# Admin token for REST /v1/* (Bearer). Generate:
#   openssl rand -hex 32
MCP_FLOW_ADMIN_TOKEN=

# Listen
MCP_FLOW_HOST=0.0.0.0
MCP_FLOW_PORT=8787

# SQLite path (default: ./data/mcp-flow.db)
MCP_FLOW_DB_PATH=./data/mcp-flow.db

# Allow backend URLs targeting private/link-local ranges (default: false)
MCP_FLOW_ALLOW_PRIVATE_URLS=false

# Default workspace name on bootstrap
MCP_FLOW_WORKSPACE_NAME=default

# Stdio shim (mcp-flow stdio)
# MCP_FLOW_URL=http://127.0.0.1:8787/mcp
# MCP_FLOW_API_KEY=
