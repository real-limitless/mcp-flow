# Optional for docker compose: if empty, the container generates and stores
# keys in the mcp-flow-data volume (/data/secrets.env). Set these to pin them.
#   openssl rand -base64 32
MCP_FLOW_MASTER_KEY=

# Admin token for REST /v1/* and /admin/ (Bearer). Generate:
#   openssl rand -hex 32
MCP_FLOW_ADMIN_TOKEN=

# Host URL written into /data/mcp-client.json by compose bootstrap
# MCP_FLOW_PUBLIC_URL=http://127.0.0.1:8787

# Listen
MCP_FLOW_HOST=0.0.0.0
MCP_FLOW_PORT=8787

# SQLite path (default: ./data/mcp-flow.db)
MCP_FLOW_DB_PATH=./data/mcp-flow.db

# Allow backend URLs targeting private/link-local ranges (default: false)
MCP_FLOW_ALLOW_PRIVATE_URLS=false

# Default workspace name on bootstrap
MCP_FLOW_WORKSPACE_NAME=default

# Stdio shim (mcp-flow stdio)
# MCP_FLOW_URL=http://127.0.0.1:8787/mcp
# MCP_FLOW_API_KEY=

# Central-sandbox OCI runtime (docker | podman)
# MCP_FLOW_CONTAINER_RUNTIME=docker

# Trust X-Forwarded-For for audit IP (only behind a trusted reverse proxy)
# MCP_FLOW_TRUST_PROXY=false

# Max JSON bytes per audit detail blob (default 65536). Tool args+results are stored redacted.
# MCP_FLOW_AUDIT_MAX_DETAIL_BYTES=65536

# Edge agent
# MCP_FLOW_DEVICE_TOKEN=

# Tailscale sidecar (starts with the stack; Headscale/custom login server)
# Never commit real values.
# TS_AUTHKEY=
# TS_HOSTNAME=mcp-flow
# TS_LOGIN_SERVER=https://headscale.example.com
# Optional extra `tailscale up` flags (tags, etc.)
# TS_EXTRA_ARGS=
