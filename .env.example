# Optional for docker compose: if empty, the container generates and stores
# keys in the mcp-flow-data volume (/data/secrets.env). Set these to pin them.
#   openssl rand -base64 32
MCP_FLOW_MASTER_KEY=

# Admin token for REST /v1/* and /admin/ (Bearer). Generate:
#   openssl rand -hex 32
MCP_FLOW_ADMIN_TOKEN=
# DEV ONLY: key material for agent-key pepper, pending-call args encryption and args_hash.
# Unset = derived from MCP_FLOW_MASTER_KEY.
# Production (MCP_FLOW_PRODUCTION=true or NODE_ENV=production) refuses this value
# and every other env or HKDF key, including a pepper supplied in the environment.
MCP_FLOW_POLICY_DEV_KEY=

# Production keyring. The KEK is a 32-byte file (mode 0400), never an environment value.
# A Docker secret is the same kind of file: mount it and point MCP_FLOW_KEK_FILE at it.
# MCP_FLOW_PRODUCTION=true
# MCP_FLOW_KEYRING_DIR=/var/lib/mcp-flow/keyring
# MCP_FLOW_KEK_FILE=/var/lib/mcp-flow/kek
# MCP_FLOW_KEK_PROVIDER=file
# kms is a code hook. Do not put KMS credentials or the KEK in the environment.
# MCP_FLOW_KEK_PROVIDER=kms
# Host-only protected deployment ids (comma-separated). The API cannot read or change them.
# MCP_FLOW_PROTECTED_TARGETS=

# Public origin of this gateway. OAuth redirect URI is
# ${MCP_FLOW_PUBLIC_URL}/oauth/callback — register that exact URL with the provider.
# Also written into /data/mcp-client.json by compose bootstrap.
# MCP_FLOW_PUBLIC_URL=http://127.0.0.1:8787

# Listen
MCP_FLOW_HOST=0.0.0.0
MCP_FLOW_PORT=8787

# SQLite path (default: ./data/mcp-flow.db)
MCP_FLOW_DB_PATH=./data/mcp-flow.db

# Persistent npm/npx cache for stdio backends (`npx -y …`). Defaults to
# $MCP_FLOW_DATA_DIR/npm-cache (Compose: /data/npm-cache on the volume).
# Avoids overlayfs ENOTEMPTY / missing SDK files in /home/node/.npm/_npx.
# MCP_FLOW_NPM_CACHE=/data/npm-cache

# Allow backend URLs targeting private/link-local ranges (default: false)
MCP_FLOW_ALLOW_PRIVATE_URLS=false

# Default workspace name on bootstrap
MCP_FLOW_WORKSPACE_NAME=default

# Stdio shim (mcp-flow stdio)
# MCP_FLOW_URL=http://127.0.0.1:8787/mcp
# MCP_FLOW_API_KEY=

# Central-sandbox OCI runtime (docker | podman)
# MCP_FLOW_CONTAINER_RUNTIME=docker

# Trust X-Forwarded-For for audit IP (only behind a trusted reverse proxy)
# MCP_FLOW_TRUST_PROXY=false

# Max JSON bytes per audit detail blob (default 65536). Tool args+results are stored redacted.
# MCP_FLOW_AUDIT_MAX_DETAIL_BYTES=65536

# Edge agent (full stack reads the token bootstrap writes).
# Edge-only compose (docker-compose.edge.yaml) needs both of these set
# in the shell or in Dokploy. Use placeholders here; do not commit real values.
# MCP_FLOW_URL=https://mcp-flow.example
# MCP_FLOW_DEVICE_TOKEN=replace-with-device-token
# MCP_FLOW_EDGE_NAME=edge

# Tailscale sidecar (starts with the stack; Headscale/custom login server).
# Inbound serve does not route backend egress. Select a connection per backend.
# Never commit real values.
# TS_AUTHKEY=
# TS_HOSTNAME=mcp-flow
# TS_LOGIN_SERVER=https://headscale.example.com
# Optional extra `tailscale up` flags (tags, etc.)
# TS_EXTRA_ARGS=
# Named sidecar catalog. Compose sets this. Backends stay on the normal path until selected.
# Display names edited in Admin are kept across restarts. Proxy URLs are refreshed.
# MCP_FLOW_SIDECARS=[{"slug":"tailscale","displayName":"Tailscale","kind":"tailscale","httpProxy":"http://tailscale:1055","socksProxy":"socks5h://tailscale:1056"}]
# Network joined by a central-sandbox container when it selects a gateway connection
# and does not set its own network mode.
# MCP_FLOW_EGRESS_NETWORK=mcp-flow

# Public origin for links sent to humans (Web Push approve links). Bare https origin.
# Never derived from request headers; when unset, push notifications carry no link.
MCP_FLOW_PUBLIC_URL=

# SQLite WAL size kept on disk after a checkpoint (PRAGMA journal_size_limit), whole MiB.
# Default 64, clamped 1..4096.
# MCP_FLOW_JOURNAL_SIZE_LIMIT_MB=64

# Per-agent tools/call rate limit (in-memory token bucket per agent): calls per minute.
# 0 or unset = off (default).
# MCP_FLOW_RATE_LIMIT_PER_MIN=0

# Backend startup (stdio / OCI / remote MCP backends).
# How long a CALLER waits for a backend that is still starting (ms; default 20000, clamped 1000..120000).
# Past it the call gets a typed backend_unavailable ("starting", retry_after_ms) and tools/list leaves the
# backend out, but the backend is NOT killed: its init keeps running, later calls succeed once it is ready,
# and clients get notifications/tools/list_changed when its tools arrive.
# MCP_FLOW_BACKEND_INIT_TIMEOUT_MS=20000
# Absolute ceiling for one init attempt (ms; default 300000, clamped to the value above..1800000). Past it
# the spawn is killed and the backend backs off: 30 s, 60 s, ... up to 10 min between attempts. A backend
# whose process exits or errors during init backs off 1 s, 2 s, ... up to 60 s. Calls during a backoff fail
# fast with backend_unavailable. Invalid or out-of-range values are logged at startup.
# MCP_FLOW_BACKEND_INIT_HARD_TIMEOUT_MS=300000
