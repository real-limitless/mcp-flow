# DEV stack only. docker-compose.yml does not read this file.
# Copy to .env.dev (gitignored) and replace placeholders at create.
#
#   docker compose --env-file .env.dev -f docker-compose.dev.yml up --build -d
#
# Compose maps the MCP_FLOW_DEV_* / TS_DEV_* names below onto the container
# variables. A sibling .env for the other stack is not a source for them.

# Fresh secrets for this stack, or leave empty. Empty makes the entrypoint
# generate values into volume mcp-flow-dev-data (/data/secrets.env).
# Maps to MCP_FLOW_MASTER_KEY and MCP_FLOW_ADMIN_TOKEN.
#   openssl rand -base64 32
#   openssl rand -hex 32
MCP_FLOW_DEV_MASTER_KEY=
MCP_FLOW_DEV_ADMIN_TOKEN=

# Maps to MCP_FLOW_PUBLIC_URL. https origin only, no path.
# OAuth callback is this origin + /oauth/callback.
# Placeholder below. Replace it at create. Do not reuse another stack's origin.
MCP_FLOW_DEV_PUBLIC_URL=https://mcp-flow-dev.example.com

# Maps to MCP_FLOW_CORS_ORIGINS. Empty, or a comma-separated origin list.
# Never set this to *.
MCP_FLOW_DEV_CORS_ORIGINS=

# Tailscale sidecar for this stack only. Placeholders below.
# Map to TS_AUTHKEY, TS_HOSTNAME, and TS_LOGIN_SERVER.
# Use a new auth key. Do not reuse another node's hostname.
TS_DEV_AUTHKEY=
TS_DEV_HOSTNAME=mcp-flow-dev
TS_DEV_LOGIN_SERVER=https://headscale.example.com
# Optional extra tailscale up flags.
# TS_DEV_EXTRA_ARGS=

# Optional. Maps to MCP_FLOW_WORKSPACE_NAME. Project slug is separate.
# MCP_FLOW_DEV_WORKSPACE_NAME=default

# Intended project slug to create in Admin after boot: mcp_flow_dev
# Day-1 backends: echo and health only. This file does not register them.

# Set in docker-compose.dev.yml, not here:
#   ENVIRONMENT=staging
#   MCP_FLOW_ALLOW_PRIVATE_URLS=false
#   MCP_FLOW_REFUSE_LEGACY_MCP_KEYS=true
#   MCP_FLOW_DB_PATH=/data/mcp-flow.db
#   MCP_FLOW_LOCK_PATH=/data/mcp-flow.lock
#   MCP_FLOW_TRUST_PROXY=true
